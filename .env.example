# Web app (apps/web). Both are public: the publishable key only works through row-level security.
# Defaults for the Palate project are built in, so these are optional unless you use another project.
VITE_SUPABASE_URL=https://zfnlftgwjwugxnymkuzi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Never put the secret (service-role) key here or in any VITE_ variable: VITE_ values ship to the browser.

# Server only (never VITE_). Live menus: USDA FoodData Central key, free at
# https://fdc.nal.usda.gov/api-key-signup. Without it the server uses USDA's DEMO_KEY (30 requests/hour).
USDA_FDC_API_KEY=
# Optional contact added to the menu bot's User-Agent, so USC Hospitality can reach the team.
MENU_BOT_CONTACT=
